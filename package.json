{
  "name": "oneclient",
  "private": true,
  "version": "0.1.0",
  "description": "One client for everything — plug-and-play desktop console for infrastructure tools",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build",
    "typecheck": "pnpm -r --filter=./packages/** run typecheck",
    "test": "pnpm -r --filter=./packages/** run test",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "web:install": "pnpm install --filter \"@oneclient/server...\" --filter \"./packages/plugins/**\"",
    "web:build": "pnpm --filter \"@oneclient/server...\" --filter \"./packages/plugins/**\" run build",
    "web:start": "node packages/server/dist/main.js"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0",
    "typescript": "^5.6.0"
  }
}
