{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@oneclient/backend/shared/*": ["../backend/src/shared/*"]
    }
  },
  "include": ["src", "views", "test"]
}
