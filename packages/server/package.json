{
  "name": "@oneclient/server",
  "private": true,
  "version": "0.1.0",
  "description": "oneClient's self-hosted web runtime: @oneclient/backend on plain Node behind an HTTP + WebSocket server, serving the @oneclient/workbench UI to a browser. No Electron dependency.",
  "license": "MIT",
  "main": "./dist/main.js",
  "bin": {
    "oneclient-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@oneclient/backend": "workspace:*",
    "@oneclient/plugin-api": "workspace:*",
    "@oneclient/workbench": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
