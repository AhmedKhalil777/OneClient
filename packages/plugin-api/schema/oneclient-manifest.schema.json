{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneclient.dev/schemas/oneclient-manifest.schema.json",
  "title": "oneClient Plugin Manifest",
  "description": "Schema for oneclient.json. Mirrors packages/plugin-api/src/manifest.ts — keep both in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "engines"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique plugin id, conventionally oneclient-<tool>.",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 3,
      "maxLength": 64
    },
    "displayName": { "type": "string", "maxLength": 64 },
    "description": { "type": "string", "maxLength": 300 },
    "version": {
      "type": "string",
      "description": "Semver version of this plugin.",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": { "type": "string", "maxLength": 64 },
    "icon": { "type": "string" },
    "license": { "type": "string" },
    "repository": { "type": "string", "format": "uri" },

    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneclient"],
      "properties": {
        "oneclient": {
          "type": "string",
          "description": "Semver range this plugin is compatible with, checked against @oneclient/plugin-api's PLUGIN_API_VERSION.",
          "examples": ["^0.1.0"]
        }
      }
    },

    "main": {
      "type": "string",
      "description": "Path, relative to the plugin root, to the compiled entry module run in the extension host. Omit for declarative plugins that only contribute data (themes, icons)."
    },
    "ui": {
      "type": "string",
      "description": "Path, relative to the plugin root, to the Tier 2 UI bundle root. Required if any contributes.views[].tier is 2."
    },

    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectionTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/connectionTypeContribution" }
        },
        "explorerNodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/explorerNodeContribution" }
        },
        "explorerSections": {
          "type": "array",
          "description": "Extra sidebar sections (under Connections), each a tree per connection rooted at rootNodeType.",
          "items": {
            "type": "object",
            "required": ["id", "title", "rootNodeType"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
              "title": { "type": "string", "maxLength": 40 },
              "rootNodeType": { "type": "string" },
              "connectionType": { "type": "string" },
              "collapsed": { "type": "boolean" }
            }
          }
        },
        "views": {
          "type": "array",
          "items": { "$ref": "#/$defs/viewContribution" }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandContribution" }
        },
        "themes": {
          "type": "array",
          "description": "Color themes.",
          "items": { "$ref": "#/$defs/colorThemeContribution" }
        },
        "iconThemes": {
          "type": "array",
          "description": "Icon themes that restyle icon ids.",
          "items": { "$ref": "#/$defs/iconThemeContribution" }
        },
        "searchProviders": {
          "type": "array",
          "description": "Global search providers: core calls each provider's command (once per saved connection) as the user types in the top search box.",
          "items": {
            "type": "object",
            "required": ["id", "label", "command"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
              "label": { "type": "string", "maxLength": 60 },
              "command": { "type": "string" },
              "connectionType": { "type": "string" },
              "order": { "type": "number" },
              "icon": { "type": "string" }
            }
          }
        },
        "menus": {
          "type": "array",
          "description": "Items in the title bar menus: run a command of this plugin, or press a keybinding in the active editor tab (one of this plugin's views).",
          "items": {
            "type": "object",
            "required": ["menu"],
            "additionalProperties": false,
            "properties": {
              "menu": { "enum": ["file", "edit", "view", "go", "run", "terminal", "help"] },
              "title": { "type": "string", "maxLength": 60 },
              "command": { "type": "string" },
              "keybinding": { "type": "string", "pattern": "^((Ctrl|Shift|Alt)[+])*([A-Za-z0-9]|F[0-9]{1,2}|Enter|Escape|Tab|Space|Delete|Backspace|Up|Down|Left|Right|Home|End|PageUp|PageDown)$" },
              "when": { "type": "string" },
              "group": { "type": "string" }
            }
          }
        },
        "icons": {
          "type": "array",
          "description": "New icon ids any plugin can use as $(id).",
          "items": { "$ref": "#/$defs/iconContribution" }
        },
        "extensions": {
          "type": "object",
          "description": "Contributions to other plugins' extension points, keyed by point id (<owning plugin id>.<name>). The owning plugin defines the item shape.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[a-zA-Z][a-zA-Z0-9.-]*$" },
          "additionalProperties": { "type": "array", "items": { "type": "object" } }
        }
      }
    },

    "activationEvents": {
      "type": "array",
      "description": "Events that trigger activation. Omit, or use [\"*\"], to activate eagerly at app start.",
      "items": { "type": "string" }
    }
  },

  "allOf": [
    {
      "$comment": "If any contributed view is Tier 2, the top-level `ui` bundle path is mandatory.",
      "if": {
        "type": "object",
        "properties": {
          "contributes": {
            "type": "object",
            "properties": {
              "views": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "tier": { "const": 2 } },
                  "required": ["tier"]
                }
              }
            },
            "required": ["views"]
          }
        },
        "required": ["contributes"]
      },
      "then": { "type": "object", "properties": { "ui": { "type": "string" } }, "required": ["ui"] }
    }
  ],

  "$defs": {
    "colorThemeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "uiTheme", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "label": { "type": "string" },
        "uiTheme": { "type": "string", "enum": ["dark", "light", "hc"] },
        "path": { "type": "string", "description": "JSON file relative to the plugin root: { \"colors\": { \"editor.background\": \"#…\" } }" }
      }
    },

    "iconThemeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "label": { "type": "string" },
        "path": { "type": "string", "description": "JSON file relative to the plugin root: { \"icons\": { \"<icon id>\": \"path.svg\" } }" }
      }
    },

    "iconContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
        "description": { "type": "string" },
        "path": { "type": "string" },
        "colored": { "type": "boolean" }
      }
    },

    "contributionId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$",
      "minLength": 1,
      "maxLength": 128
    },

    "connectionTypeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "category": { "type": "string" },
        "connectionLabel": { "type": "string", "maxLength": 30, "description": "What one saved connection is called in the UI (\"Folder\", \"Server\", \"Cluster\"). Default \"Connection\"." },
        "connectionLabelPlural": { "type": "string", "maxLength": 30, "description": "Plural of connectionLabel, used as the sidebar section heading. Default: connectionLabel + \"s\"." }
      }
    },

    "explorerNodeContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "label": { "type": "string" },
        "parentNodeType": { "$ref": "#/$defs/contributionId" },
        "connectionType": { "$ref": "#/$defs/contributionId" },
        "icon": { "type": "string" }
      }
    },

    "viewContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "tier", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "type": "string" },
        "tier": { "type": "integer", "enum": [1, 2] },
        "location": { "type": "string", "enum": ["sidebar", "panel", "editor"] },
        "icon": { "type": "string" },
        "entry": {
          "type": "string",
          "description": "Path, relative to manifest.ui, to this view's entry HTML. Required if tier is 2."
        },
        "connectionType": {
          "$ref": "#/$defs/contributionId",
          "description": "If set, this view is scoped to one saved connection of that type (e.g. a per-connection dashboard)."
        }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "tier": { "const": 2 } } },
          "then": {
            "type": "object",
            "properties": { "entry": { "type": "string" } },
            "required": ["entry"]
          }
        }
      ]
    },

    "commandContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "keybinding": { "type": "string" },
        "hidden": { "type": "boolean", "description": "Not shown in the command palette; callable only by code." },
        "when": {
          "type": "string",
          "description": "Context-menu visibility guard, e.g. \"contextValue == 'postgres.table'\". Omit to show only in the command palette."
        },
        "confirm": {
          "type": "string",
          "description": "If set, core asks the user to confirm before running. {label} is replaced with the right-clicked item's label."
        },
        "inputSchema": {
          "type": "object",
          "description": "JSON Schema for one object core should collect via a generic form before invoking this command, passed as args[0]."
        }
      }
    }
  }
}
