{
  "name": "@oneclient/plugin-api",
  "version": "0.1.0",
  "description": "The only surface oneClient plugins are allowed to depend on: contribution interfaces, manifest types, and the plugin activation context.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/oneclient-manifest.schema.json": "./schema/oneclient-manifest.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
