{
  "name": "oneclient-postgres",
  "displayName": "PostgreSQL",
  "description": "Connect to PostgreSQL: databases, schemas, tables, views, functions and procedures; query windows with IntelliSense, result grids, NOTICE messages, cancel, CREATE / ALTER scripts and object search.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "icon.svg",
  "engines": {
    "oneclient": "^0.1.0"
  },
  "main": "dist/main.js",
  "ui": "dist/ui",
  "contributes": {
    "icons": [{ "id": "postgresql", "description": "PostgreSQL", "path": "icon.svg", "colored": true }],
    "extensions": {
      "docker.containerTemplates": [
        {
          "id": "postgres",
          "title": "PostgreSQL 17",
          "product": "PostgreSQL",
          "description": "The official postgres image with a fresh, empty cluster.",
          "icon": "$(postgresql)",
          "image": "postgres:17",
          "imagePatterns": [
            "^(docker\\.io/)?(library/)?postgres([:@]|$)",
            "postgis/postgis",
            "timescale/timescaledb",
            "bitnami/postgresql",
            "pgvector/pgvector",
            "supabase/postgres"
          ],
          "ports": [
            {
              "container": "5432/tcp",
              "host": 5432,
              "label": "PostgreSQL"
            }
          ],
          "env": {
            "POSTGRES_PASSWORD": "${password}"
          },
          "variables": {
            "password": {
              "label": "Password (user postgres)",
              "secret": true,
              "from": [
                {
                  "env": "POSTGRES_PASSWORD"
                },
                {
                  "env": "POSTGRESQL_PASSWORD"
                }
              ]
            }
          },
          "connection": {
            "typeId": "postgres",
            "name": "Local PostgreSQL",
            "config": {
              "host": "${host}",
              "port": "${port}",
              "user": "postgres",
              "password": "${password}",
              "database": "postgres",
              "ssl": "Disable"
            }
          },
          "startupSeconds": 90
        }
      ]
    },
    "connectionTypes": [
      {
        "id": "postgres",
        "label": "PostgreSQL",
        "description": "PostgreSQL (also Azure, RDS, Supabase, Neon, TimescaleDB…)",
        "category": "Databases",
        "icon": "icon.svg",
        "connectionLabel": "Server"
      }
    ],
    "explorerNodes": [
      {
        "id": "postgres.databases",
        "connectionType": "postgres"
      },
      {
        "id": "postgres.database",
        "parentNodeType": "postgres.databases"
      },
      {
        "id": "postgres.schemas",
        "parentNodeType": "postgres.database"
      },
      {
        "id": "postgres.systemSchemas",
        "parentNodeType": "postgres.schemas"
      },
      {
        "id": "postgres.schema",
        "parentNodeType": "postgres.schemas"
      },
      {
        "id": "postgres.tables",
        "parentNodeType": "postgres.schema"
      },
      {
        "id": "postgres.table",
        "parentNodeType": "postgres.tables"
      },
      {
        "id": "postgres.views",
        "parentNodeType": "postgres.schema"
      },
      {
        "id": "postgres.view",
        "parentNodeType": "postgres.views"
      },
      {
        "id": "postgres.matviews",
        "parentNodeType": "postgres.schema"
      },
      {
        "id": "postgres.matview",
        "parentNodeType": "postgres.matviews"
      },
      {
        "id": "postgres.functions",
        "parentNodeType": "postgres.schema"
      },
      {
        "id": "postgres.function",
        "parentNodeType": "postgres.functions"
      },
      {
        "id": "postgres.procedures",
        "parentNodeType": "postgres.schema"
      },
      {
        "id": "postgres.procedure",
        "parentNodeType": "postgres.procedures"
      },
      {
        "id": "postgres.sequences",
        "parentNodeType": "postgres.schema"
      },
      {
        "id": "postgres.sequence",
        "parentNodeType": "postgres.sequences"
      },
      {
        "id": "postgres.columns",
        "parentNodeType": "postgres.table"
      },
      {
        "id": "postgres.column",
        "parentNodeType": "postgres.columns"
      },
      {
        "id": "postgres.indexes",
        "parentNodeType": "postgres.table"
      },
      {
        "id": "postgres.index",
        "parentNodeType": "postgres.indexes"
      },
      {
        "id": "postgres.constraints",
        "parentNodeType": "postgres.table"
      },
      {
        "id": "postgres.constraint",
        "parentNodeType": "postgres.constraints"
      },
      {
        "id": "postgres.fastToolsRoot"
      },
      {
        "id": "postgres.fastQueriesRoot",
        "parentNodeType": "postgres.fastToolsRoot"
      },
      {
        "id": "postgres.fastQueryGroup",
        "parentNodeType": "postgres.fastQueriesRoot"
      },
      {
        "id": "postgres.fastQuery",
        "parentNodeType": "postgres.fastQueryGroup"
      }
    ],
    "views": [
      {
        "id": "postgres.query",
        "title": "Query",
        "tier": 2,
        "location": "editor",
        "entry": "index.html"
      },
      {
        "id": "postgres.diagram",
        "title": "Diagram",
        "tier": 2,
        "location": "editor",
        "entry": "diagram.html",
        "icon": "$(diagram)"
      },
      {
        "id": "postgres.results",
        "title": "PostgreSQL Results",
        "tier": 2,
        "location": "panel",
        "entry": "results.html",
        "icon": "$(results)"
      },
      {
        "id": "postgres.tableEditor",
        "title": "Table Data",
        "tier": 2,
        "location": "editor",
        "entry": "table-editor.html",
        "icon": "$(table)"
      },
      {
        "id": "postgres.importCsv",
        "title": "Import CSV",
        "tier": 2,
        "location": "editor",
        "entry": "import-csv.html",
        "icon": "$(add)"
      },
      {
        "id": "postgres.plan",
        "title": "Execution Plan",
        "tier": 2,
        "location": "editor",
        "entry": "plan.html",
        "icon": "$(diagram)"
      }
    ],
    "commands": [
      {
        "id": "postgres.newQuery",
        "title": "PostgreSQL: New Query",
        "when": "contextValue == 'connection' && connectionType == 'postgres' || contextValue == 'postgres.database' || contextValue == 'postgres.schema'"
      },
      {
        "id": "postgres.createDatabase",
        "title": "PostgreSQL: Create Database…",
        "when": "contextValue == 'postgres.databases'",
        "inputSchema": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Database name"
            },
            "encoding": {
              "type": "string",
              "title": "Encoding (optional)",
              "description": "e.g. UTF8 or LATIN1 — empty uses the server default.",
              "examples": [
                "UTF8"
              ]
            }
          }
        }
      },
      {
        "id": "postgres.queryHistory",
        "title": "PostgreSQL: Query History",
        "when": "contextValue == 'connection' && connectionType == 'postgres' || contextValue == 'postgres.database' || contextValue == 'postgres.schema'"
      },
      {
        "id": "postgres.diagram",
        "title": "PostgreSQL: Database Diagram",
        "icon": "$(diagram)",
        "when": "contextValue == 'postgres.database' || contextValue == 'postgres.schema' || contextValue == 'postgres.tables' || contextValue == 'postgres.table'"
      },
      {
        "id": "postgres.erModel",
        "title": "PostgreSQL: Diagram Model",
        "hidden": true
      },
      {
        "id": "postgres.selectTop",
        "title": "PostgreSQL: Select Top 1000 Rows",
        "when": "contextValue == 'postgres.table' || contextValue == 'postgres.view' || contextValue == 'postgres.matview'"
      },
      {
        "id": "postgres.countRows",
        "title": "PostgreSQL: Count Rows",
        "when": "contextValue == 'postgres.table' || contextValue == 'postgres.view' || contextValue == 'postgres.matview'"
      },
      {
        "id": "postgres.scriptCreate",
        "title": "PostgreSQL: Script Table as CREATE",
        "when": "contextValue == 'postgres.table'"
      },
      {
        "id": "postgres.scriptInsert",
        "title": "PostgreSQL: Script as INSERT",
        "when": "contextValue == 'postgres.table'"
      },
      {
        "id": "postgres.scriptModify",
        "title": "PostgreSQL: Script as CREATE OR REPLACE",
        "when": "contextValue == 'postgres.view' || contextValue == 'postgres.matview' || contextValue == 'postgres.function' || contextValue == 'postgres.procedure' || contextValue == 'postgres.sequence'"
      },
      {
        "id": "postgres.scriptExecute",
        "title": "PostgreSQL: Script as SELECT / CALL",
        "when": "contextValue == 'postgres.function' || contextValue == 'postgres.procedure'"
      },
      {
        "id": "postgres.newFastQuery",
        "title": "PostgreSQL: New Fast Query…",
        "when": "contextValue == 'postgres.fastQueriesRoot' || contextValue == 'postgres.fastQueryGroup'"
      },
      {
        "id": "postgres.runFastQuery",
        "title": "PostgreSQL: Run Fast Query",
        "icon": "$(play)",
        "when": "contextValue == 'postgres.fastQuery'"
      },
      {
        "id": "postgres.runFastQueryOn",
        "title": "PostgreSQL: Run Fast Query on Database…",
        "when": "contextValue == 'postgres.fastQuery'",
        "inputSchema": {
          "type": "object",
          "required": [
            "targetDatabase"
          ],
          "properties": {
            "targetDatabase": {
              "type": "string",
              "title": "Database"
            }
          }
        }
      },
      {
        "id": "postgres.renameFastQuery",
        "title": "PostgreSQL: Rename Fast Query…",
        "when": "contextValue == 'postgres.fastQuery'",
        "inputSchema": {
          "type": "object",
          "required": [
            "newName"
          ],
          "properties": {
            "newName": {
              "type": "string",
              "title": "New name",
              "default": "{label}"
            }
          }
        }
      },
      {
        "id": "postgres.deleteFastQuery",
        "title": "PostgreSQL: Delete Fast Query",
        "when": "contextValue == 'postgres.fastQuery'",
        "confirm": "Delete fast query \"{label}\" (its .query.sql file)?"
      },
      {
        "id": "postgres.saveFastQuery",
        "title": "PostgreSQL: Save Fast Query",
        "hidden": true
      },
      {
        "id": "postgres.attachFastToolsFolder",
        "title": "PostgreSQL: Attach Fast Tools Folder…",
        "when": "contextValue == 'postgres.fastToolsRoot' || contextValue == 'postgres.fastToolsFolder'",
        "inputSchema": {
          "type": "object",
          "required": [
            "folder"
          ],
          "properties": {
            "folder": {
              "type": "string",
              "title": "Folder for fast queries (*.query.sql)",
              "format": "directory"
            }
          }
        }
      },
      {
        "id": "postgres.detachFastToolsFolder",
        "title": "PostgreSQL: Detach Fast Tools Folder",
        "when": "contextValue == 'postgres.fastToolsFolder'",
        "confirm": "Detach this folder? Its fast queries stay on disk."
      },
      {
        "id": "postgres.editData",
        "title": "PostgreSQL: Edit Data",
        "when": "contextValue == 'postgres.table'"
      },
      {
        "id": "postgres.tableData",
        "title": "PostgreSQL: Table Data API",
        "hidden": true
      },
      {
        "id": "postgres.importCsv",
        "title": "PostgreSQL: Import CSV…",
        "when": "contextValue == 'postgres.table'",
        "inputSchema": {
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "title": "CSV file",
              "format": "file",
              "x-file-extensions": [
                "csv",
                "tsv",
                "txt"
              ]
            }
          }
        }
      },
      {
        "id": "postgres.importData",
        "title": "PostgreSQL: Import API",
        "hidden": true
      },
      {
        "id": "postgres.explain",
        "title": "PostgreSQL: Execution Plan API",
        "hidden": true
      },
      {
        "id": "postgres.history",
        "title": "PostgreSQL: List Query History",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.deleteHistory",
        "title": "PostgreSQL: Delete Query History",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.executeQuery",
        "title": "PostgreSQL: Execute Query",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.cancelQuery",
        "title": "PostgreSQL: Cancel Query",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.listDatabases",
        "title": "PostgreSQL: List Databases",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.serverInfo",
        "title": "PostgreSQL: Server Info",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.completionCatalog",
        "title": "PostgreSQL: IntelliSense Catalog",
        "when": "view == 'postgres.query'"
      },
      {
        "id": "postgres.search",
        "title": "PostgreSQL: Search Objects",
        "hidden": true
      }
    ],
    "searchProviders": [
      {
        "id": "objects",
        "label": "PostgreSQL objects",
        "command": "postgres.search",
        "connectionType": "postgres",
        "order": 21,
        "icon": "$(database)"
      }
    ],
    "menus": [
      {
        "menu": "run",
        "title": "Execute Query",
        "keybinding": "F5",
        "when": "activeView == 'postgres.query'",
        "group": "1_run"
      },
      {
        "menu": "run",
        "title": "Cancel Query",
        "keybinding": "Escape",
        "when": "activeView == 'postgres.query'",
        "group": "1_run"
      },
      {
        "menu": "run",
        "title": "Show Results",
        "keybinding": "Ctrl+R",
        "when": "activeView == 'postgres.query'",
        "group": "2_results"
      }
    ],
    "explorerSections": [
      {
        "id": "fastTools",
        "title": "Fast Tools",
        "rootNodeType": "postgres.fastToolsRoot",
        "connectionType": "postgres"
      }
    ]
  },
  "activationEvents": [
    "onConnectionType:postgres"
  ]
}
