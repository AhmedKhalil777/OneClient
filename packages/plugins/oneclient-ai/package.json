{
  "name": "oneclient-ai",
  "version": "0.1.0",
  "description": "oneClient plugin: AI assistant — chat with Claude, OpenAI, Gemini, DeepSeek, Kimi, GLM, Grok, Mistral, Qwen or any OpenAI-compatible server using your own API key, with read access to your open folders and edits you approve.",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:node": "tsc -b",
    "build:ui": "vite build",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@oneclient/editor-kit": "workspace:*",
    "@oneclient/plugin-api": "workspace:*",
    "mermaid": "^11.17.2",
    "openai": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  }
}
