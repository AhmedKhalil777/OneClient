{
  "name": "oneclient-markdown",
  "displayName": "Markdown Preview",
  "description": "Built-in: Markdown support for the Files editor — live preview next to the source, a heading outline in the breadcrumbs, and syntax highlighting.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "$(preview)",
  "engines": { "oneclient": "^0.1.0" },
  "main": "dist/main.js",
  "contributes": {
    "commands": [
      { "id": "markdown.symbols", "title": "Markdown: Document Outline", "hidden": true },
      { "id": "markdown.tokens", "title": "Markdown: Syntax Tokens", "hidden": true },
      { "id": "markdown.preview", "title": "Markdown: Render Preview", "hidden": true }
    ],
    "extensions": {
      "oneclient-files.editors": [
        {
          "id": "markdown",
          "label": "Markdown",
          "extensions": ["md", "markdown", "mdown", "mkd", "mkdn"],
          "symbols": "markdown.symbols",
          "tokens": "markdown.tokens",
          "preview": "markdown.preview",
          "previewByDefault": true
        }
      ]
    }
  }
}
