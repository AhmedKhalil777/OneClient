{
  "name": "oneclient-xml",
  "displayName": "XML Tools",
  "description": "Built-in: XML support for the Files editor — format, breadcrumbs showing the element path at the cursor, and syntax highlighting. Covers .xml, .csproj, .config, .svg, .xaml and friends.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "$(file-code)",
  "engines": { "oneclient": "^0.1.0" },
  "main": "dist/main.js",
  "contributes": {
    "commands": [
      { "id": "xml.format", "title": "XML: Format Document", "hidden": true },
      { "id": "xml.symbols", "title": "XML: Document Symbols", "hidden": true },
      { "id": "xml.tokens", "title": "XML: Syntax Tokens", "hidden": true }
    ],
    "extensions": {
      "oneclient-files.editors": [
        {
          "id": "xml",
          "label": "XML",
          "extensions": [
            "xml", "xsd", "xsl", "xslt", "xaml", "axaml", "svg", "rss", "atom", "plist", "wsdl", "kml", "gpx", "xliff", "xlf", "resx",
            "csproj", "vbproj", "fsproj", "vcxproj", "props", "targets", "nuspec", "config", "ruleset", "runsettings", "testsettings",
            "manifest", "appxmanifest", "wxs", "storyboard", "xib", "csdl", "edmx", "vsixmanifest", "proj", "msbuild"
          ],
          "format": "xml.format",
          "symbols": "xml.symbols",
          "tokens": "xml.tokens"
        }
      ]
    }
  }
}
