{
  "name": "oneclient-docker",
  "displayName": "Docker",
  "description": "Connect to a local or remote Docker Engine: browse containers, images, volumes, networks — and run the databases, brokers and caches your other plugins support, with a ready connection to each.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "icon.svg",
  "features": [
    {
      "category": "Manage",
      "items": [
        "Containers: start, stop, restart, logs, remove",
        "Images: pull",
        "Volumes and networks",
        "Local engine or a remote one over tcp"
      ]
    },
    {
      "category": "Test infrastructure",
      "items": [
        "Templates: PostgreSQL, MySQL, SQL Server, Redis, Kafka, Azurite and Keycloak in one click",
        "Each one gets a ready connection in its plugin",
        "Every container shows which plugin and connection it belongs to"
      ]
    }
  ],
  "engines": { "oneclient": "^0.1.1" },
  "main": "dist/main.js",
  "ui": "dist/ui",
  "contributes": {
    "views": [
      {
        "id": "docker.dashboard",
        "title": "Dashboard",
        "tier": 2,
        "location": "editor",
        "entry": "index.html",
        "connectionType": "docker"
      }
    ],
    "icons": [
      { "id": "docker-container", "description": "A Docker container", "path": "icons/container.svg", "colored": true },
      { "id": "docker-image", "description": "A Docker image", "path": "icons/image.svg", "colored": true },
      { "id": "docker-volume", "description": "A Docker volume", "path": "icons/volume.svg", "colored": true },
      { "id": "docker-network", "description": "A Docker network", "path": "icons/network.svg", "colored": true }
    ],
    "connectionTypes": [{ "id": "docker", "connectionLabel": "Docker Host", "label": "Docker", "category": "Infrastructure", "icon": "icon.svg" }],
    "explorerNodes": [
      { "id": "docker.containers", "connectionType": "docker" },
      { "id": "docker.container", "parentNodeType": "docker.containers" },
      { "id": "docker.images", "connectionType": "docker" },
      { "id": "docker.image", "parentNodeType": "docker.images" },
      { "id": "docker.volumes", "connectionType": "docker" },
      { "id": "docker.volume", "parentNodeType": "docker.volumes" },
      { "id": "docker.networks", "connectionType": "docker" },
      { "id": "docker.network", "parentNodeType": "docker.networks" },
      { "id": "docker.templates", "connectionType": "docker" },
      { "id": "docker.template", "parentNodeType": "docker.templates" }
    ],
    "commands": [
      {
        "id": "docker.listContainers",
        "title": "Docker: List Containers",
        "when": "contextValue == 'connection' && connectionType == 'docker' || nodeType == 'docker.containers'"
      },
      {
        "id": "docker.listImages",
        "title": "Docker: List Images",
        "when": "contextValue == 'connection' && connectionType == 'docker' || nodeType == 'docker.images'"
      },
      { "id": "docker.startContainer", "title": "Docker: Start Container", "when": "contextValue =~ /^docker\\.container\\.stopped/" },
      { "id": "docker.stopContainer", "title": "Docker: Stop Container", "when": "contextValue =~ /^docker\\.container\\.running/" },
      { "id": "docker.restartContainer", "title": "Docker: Restart Container", "when": "contextValue =~ /^docker\\.container\\.running/" },
      {
        "id": "docker.connectContainer",
        "title": "Docker: Create Connection for Container",
        "when": "contextValue == 'docker.container.running.detached'"
      },
      {
        "id": "docker.openTemplates",
        "title": "Docker: Run Infrastructure from a Template…",
        "when": "contextValue == 'connection' && connectionType == 'docker' || nodeType == 'docker.templates'"
      },
      { "id": "docker.listTemplates", "title": "Docker: List Container Templates", "hidden": true },
      { "id": "docker.runTemplate", "title": "Docker: Run Container Template", "hidden": true },
      {
        "id": "docker.removeContainer",
        "title": "Docker: Remove Container",
        "when": "contextValue =~ /^docker\\.container\\./",
        "confirm": "Force-remove container \"{label}\"? A running container is stopped first."
      },
      {
        "id": "docker.pullImage",
        "title": "Docker: Pull Image…",
        "when": "contextValue == 'connection' && connectionType == 'docker' || nodeType == 'docker.images'",
        "inputSchema": {
          "type": "object",
          "required": ["image"],
          "properties": { "image": { "type": "string", "title": "Image", "description": "e.g. nginx:latest" } }
        }
      }
    ]
  },
  "activationEvents": ["onConnectionType:docker"]
}
