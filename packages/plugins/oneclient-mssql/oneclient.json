{
  "name": "oneclient-mssql",
  "displayName": "SQL Server",
  "description": "Connect to Microsoft SQL Server: object explorer, query editor, result grids and Fast Tools (saved fast queries, fake-data generator) — a small SSMS.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "icon.svg",
  "features": [
    {
      "category": "Explore",
      "items": [
        "Databases, schemas, tables, views, stored procedures and functions",
        "Columns, primary and foreign keys, indexes",
        "Go to any object with Ctrl+P",
        "ER diagrams of a database"
      ]
    },
    {
      "category": "Query",
      "items": [
        "Query windows with IntelliSense",
        "Several result sets and server messages per run",
        "Cancel a running query",
        "Result grids: sort, filter, multi-select, copy",
        "Export as CSV, TSV, JSON, Markdown or SQL INSERTs",
        "JSON cell viewer"
      ]
    },
    {
      "category": "Edit data",
      "items": [
        "Table data editor with staged changes and a SQL review before anything is written",
        "Import a CSV file into a table",
        "Create database from the sidebar"
      ]
    },
    {
      "category": "Performance & history",
      "items": [
        "Execution plans",
        "Searchable query history with one-click re-run",
        "Run a long query in the background and watch its clock — leave the tab and come back"
      ]
    },
    {
      "category": "Productivity",
      "items": [
        "Fast Tools: save queries per database and run them on any database",
        "Safe mode warns before UPDATE or DELETE without a WHERE",
        "Fake-data generator for tables"
      ]
    },
    {
      "category": "Connectivity",
      "items": [
        "SSH tunnels",
        "SQL Server authentication and encryption options",
        "Works with Azure SQL"
      ]
    },
    {
      "category": "AI & testing",
      "items": [
        "The AI Assistant can read the schema and run read-only queries; anything that changes data waits for your approval",
        "Docker template: SQL Server 2022 Developer edition with a ready connection"
      ]
    }
  ],
  "engines": {
    "oneclient": "^0.1.0"
  },
  "main": "dist/main.js",
  "ui": "dist/ui",
  "contributes": {
    "icons": [
      {
        "id": "sql-server",
        "description": "Microsoft SQL Server",
        "path": "icon.svg",
        "colored": true
      }
    ],
    "extensions": {
      "docker.containerTemplates": [
        {
          "id": "mssql",
          "title": "SQL Server 2022",
          "product": "SQL Server",
          "description": "SQL Server 2022 Developer edition (x64 hosts). The SA password must be at least 8 characters with 3 of: upper, lower, digit, symbol.",
          "icon": "$(sql-server)",
          "image": "mcr.microsoft.com/mssql/server:2022-latest",
          "imagePatterns": [
            "mcr\\.microsoft\\.com/mssql/server",
            "mcr\\.microsoft\\.com/azure-sql-edge"
          ],
          "ports": [
            {
              "container": "1433/tcp",
              "host": 1433,
              "label": "SQL Server"
            }
          ],
          "env": {
            "ACCEPT_EULA": "Y",
            "MSSQL_PID": "Developer",
            "MSSQL_SA_PASSWORD": "${password}"
          },
          "variables": {
            "password": {
              "label": "SA password",
              "secret": true,
              "from": [
                {
                  "env": "MSSQL_SA_PASSWORD"
                },
                {
                  "env": "SA_PASSWORD"
                }
              ]
            }
          },
          "connection": {
            "typeId": "mssql",
            "name": "Local SQL Server",
            "config": {
              "server": "${host},${port}",
              "authentication": "SQL Server Authentication",
              "user": "sa",
              "password": "${password}",
              "encrypt": true,
              "trustServerCertificate": true
            }
          },
          "startupSeconds": 150
        }
      ],
      "oneclient.aiTools": [
        {
          "name": "mssql_schema",
          "description": "List the user tables and their columns of a SQL Server connection (one line per table: schema.table(column type, …)). Call this before writing SQL so names and types are right. Optional filter matches table or schema names.",
          "command": "mssql.ai.schema",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "required": [
              "connectionId"
            ],
            "properties": {
              "connectionId": {
                "type": "string",
                "description": "A SQL Server connection id — get it from list_connections."
              },
              "database": {
                "type": "string",
                "description": "Database to run in (optional; default is the connection's)."
              },
              "filter": {
                "type": "string",
                "description": "Only tables whose name contains this text."
              }
            }
          }
        },
        {
          "name": "mssql_query",
          "description": "Run ONE read-only SQL statement (SELECT / WITH / SHOW / DESCRIBE / EXPLAIN) on a SQL Server connection and get the rows as tab-separated text. Rejects anything that could change data. Limit large results yourself.",
          "command": "mssql.ai.query",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "required": [
              "connectionId",
              "sql"
            ],
            "properties": {
              "connectionId": {
                "type": "string",
                "description": "A SQL Server connection id — get it from list_connections."
              },
              "sql": {
                "type": "string"
              },
              "database": {
                "type": "string",
                "description": "Database to run in (optional; default is the connection's)."
              },
              "maxRows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200,
                "description": "Rows to return (default 50)."
              }
            }
          }
        },
        {
          "name": "mssql_execute",
          "description": "Run any SQL on a SQL Server connection, including INSERT / UPDATE / DELETE / DDL. The user sees the statement and must approve it first. Use mssql_query for reads.",
          "command": "mssql.ai.execute",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "required": [
              "connectionId",
              "sql"
            ],
            "properties": {
              "connectionId": {
                "type": "string",
                "description": "A SQL Server connection id — get it from list_connections."
              },
              "sql": {
                "type": "string"
              },
              "database": {
                "type": "string",
                "description": "Database to run in (optional; default is the connection's)."
              }
            }
          }
        }
      ]
    },
    "connectionTypes": [
      {
        "id": "mssql",
        "label": "SQL Server",
        "description": "Microsoft SQL Server / Azure SQL",
        "category": "Databases",
        "icon": "icon.svg",
        "connectionLabel": "Server"
      }
    ],
    "explorerNodes": [
      {
        "id": "mssql.databases",
        "connectionType": "mssql"
      },
      {
        "id": "mssql.systemDatabases",
        "parentNodeType": "mssql.databases"
      },
      {
        "id": "mssql.database",
        "parentNodeType": "mssql.databases"
      },
      {
        "id": "mssql.tables",
        "parentNodeType": "mssql.database"
      },
      {
        "id": "mssql.table",
        "parentNodeType": "mssql.tables"
      },
      {
        "id": "mssql.views",
        "parentNodeType": "mssql.database"
      },
      {
        "id": "mssql.view",
        "parentNodeType": "mssql.views"
      },
      {
        "id": "mssql.columns",
        "parentNodeType": "mssql.table"
      },
      {
        "id": "mssql.column",
        "parentNodeType": "mssql.columns"
      },
      {
        "id": "mssql.indexes",
        "parentNodeType": "mssql.table"
      },
      {
        "id": "mssql.index",
        "parentNodeType": "mssql.indexes"
      },
      {
        "id": "mssql.programmability",
        "parentNodeType": "mssql.database"
      },
      {
        "id": "mssql.procedures",
        "parentNodeType": "mssql.programmability"
      },
      {
        "id": "mssql.procedure",
        "parentNodeType": "mssql.procedures"
      },
      {
        "id": "mssql.functions",
        "parentNodeType": "mssql.programmability"
      },
      {
        "id": "mssql.function",
        "parentNodeType": "mssql.functions"
      },
      {
        "id": "mssql.fastToolsRoot"
      },
      {
        "id": "mssql.fastQueriesRoot",
        "parentNodeType": "mssql.fastToolsRoot"
      },
      {
        "id": "mssql.fastQueryGroup",
        "parentNodeType": "mssql.fastQueriesRoot"
      },
      {
        "id": "mssql.fastQuery",
        "parentNodeType": "mssql.fastQueryGroup"
      },
      {
        "id": "mssql.historyRoot"
      },
      {
        "id": "mssql.historyGroup",
        "parentNodeType": "mssql.historyRoot"
      },
      {
        "id": "mssql.historyEntry",
        "parentNodeType": "mssql.historyGroup"
      },
      {
        "id": "mssql.backgroundRoot"
      },
      {
        "id": "mssql.backgroundTask",
        "parentNodeType": "mssql.backgroundRoot"
      },
      {
        "id": "mssql.fakersRoot",
        "parentNodeType": "mssql.fastToolsRoot"
      },
      {
        "id": "mssql.fakerGroup",
        "parentNodeType": "mssql.fakersRoot"
      },
      {
        "id": "mssql.faker",
        "parentNodeType": "mssql.fakerGroup"
      }
    ],
    "views": [
      {
        "id": "mssql.query",
        "title": "Query",
        "tier": 2,
        "location": "editor",
        "entry": "index.html"
      },
      {
        "id": "mssql.diagram",
        "title": "Diagram",
        "tier": 2,
        "location": "editor",
        "entry": "diagram.html",
        "icon": "$(diagram)"
      },
      {
        "id": "mssql.results",
        "title": "Query Results",
        "tier": 2,
        "location": "panel",
        "entry": "results.html",
        "icon": "$(results)"
      },
      {
        "id": "mssql.faker",
        "title": "Fake Data",
        "tier": 2,
        "location": "editor",
        "entry": "faker.html",
        "icon": "$(wrench)"
      },
      {
        "id": "mssql.tableEditor",
        "title": "Table Data",
        "tier": 2,
        "location": "editor",
        "entry": "table-editor.html",
        "icon": "$(table)"
      },
      {
        "id": "mssql.importCsv",
        "title": "Import CSV",
        "tier": 2,
        "location": "editor",
        "entry": "import-csv.html",
        "icon": "$(add)"
      },
      {
        "id": "mssql.plan",
        "title": "Execution Plan",
        "tier": 2,
        "location": "editor",
        "entry": "plan.html",
        "icon": "$(diagram)"
      },
      {
        "id": "mssql.backgroundTask",
        "title": "Background Task",
        "tier": 2,
        "location": "editor",
        "entry": "background-task.html",
        "icon": "$(clock)"
      }
    ],
    "commands": [
      {
        "id": "mssql.newQuery",
        "title": "SQL Server: New Query",
        "when": "contextValue == 'connection' && connectionType == 'mssql' || contextValue == 'mssql.database'"
      },
      {
        "id": "mssql.createDatabase",
        "title": "SQL Server: Create Database…",
        "when": "contextValue == 'mssql.databases'",
        "inputSchema": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "title": "Database name"
            },
            "collation": {
              "type": "string",
              "title": "Collation (optional)",
              "description": "e.g. Latin1_General_100_CI_AS — empty uses the server default.",
              "examples": [
                "Latin1_General_100_CI_AS"
              ]
            }
          }
        }
      },
      {
        "id": "mssql.queryHistory",
        "title": "SQL Server: Query History",
        "when": "contextValue == 'connection' && connectionType == 'mssql' || contextValue == 'mssql.database'"
      },
      {
        "id": "mssql.diagram",
        "title": "SQL Server: Database Diagram",
        "icon": "$(diagram)",
        "when": "contextValue == 'mssql.database' || contextValue == 'mssql.tables' || contextValue == 'mssql.table'"
      },
      {
        "id": "mssql.erModel",
        "title": "SQL Server: Diagram Model",
        "hidden": true
      },
      {
        "id": "mssql.selectTop",
        "title": "SQL Server: Select Top 1000 Rows",
        "when": "contextValue == 'mssql.table' || contextValue == 'mssql.view'"
      },
      {
        "id": "mssql.scriptCreate",
        "title": "SQL Server: Script Table as CREATE",
        "when": "contextValue == 'mssql.table'"
      },
      {
        "id": "mssql.scriptModify",
        "title": "SQL Server: Modify",
        "when": "contextValue == 'mssql.view' || contextValue == 'mssql.procedure' || contextValue == 'mssql.function'"
      },
      {
        "id": "mssql.scriptExecute",
        "title": "SQL Server: Script as EXECUTE",
        "when": "contextValue == 'mssql.procedure'"
      },
      {
        "id": "mssql.editData",
        "title": "SQL Server: Edit Data",
        "when": "contextValue == 'mssql.table'"
      },
      {
        "id": "mssql.tableData",
        "title": "SQL Server: Table Data API",
        "hidden": true
      },
      {
        "id": "mssql.importCsv",
        "title": "SQL Server: Import CSV…",
        "when": "contextValue == 'mssql.table'",
        "inputSchema": {
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "title": "CSV file",
              "format": "file",
              "x-file-extensions": [
                "csv",
                "tsv",
                "txt"
              ]
            }
          }
        }
      },
      {
        "id": "mssql.importData",
        "title": "SQL Server: Import API",
        "hidden": true
      },
      {
        "id": "mssql.explain",
        "title": "SQL Server: Execution Plan API",
        "hidden": true
      },
      {
        "id": "mssql.runInBackground",
        "title": "SQL Server: Run in Background",
        "hidden": true
      },
      {
        "id": "mssql.backgroundTasks",
        "title": "SQL Server: Background Tasks API",
        "hidden": true
      },
      {
        "id": "mssql.cancelBackgroundTask",
        "title": "SQL Server: Cancel Background Task",
        "when": "contextValue == 'mssql.backgroundTaskRunning'"
      },
      {
        "id": "mssql.removeBackgroundTask",
        "title": "SQL Server: Remove Background Task",
        "when": "contextValue == 'mssql.backgroundTask'"
      },
      {
        "id": "mssql.rerunInBackground",
        "title": "SQL Server: Run Again in Background",
        "when": "contextValue == 'mssql.backgroundTask' || contextValue == 'mssql.backgroundTaskRunning'"
      },
      {
        "id": "mssql.openBackgroundSql",
        "title": "SQL Server: Open SQL in a Query Window",
        "when": "contextValue == 'mssql.backgroundTask' || contextValue == 'mssql.backgroundTaskRunning'"
      },
      {
        "id": "mssql.clearBackgroundTasks",
        "title": "SQL Server: Remove Finished Background Tasks",
        "when": "contextValue == 'mssql.backgroundRoot'",
        "confirm": "Remove all finished background tasks of this connection and their saved results?"
      },
      {
        "id": "mssql.runHistoryEntry",
        "title": "SQL Server: Run in a New Query Window",
        "when": "contextValue == 'mssql.historyEntry'"
      },
      {
        "id": "mssql.runHistoryEntryInBackground",
        "title": "SQL Server: Run in the Background",
        "when": "contextValue == 'mssql.historyEntry'"
      },
      {
        "id": "mssql.deleteHistoryEntry",
        "title": "SQL Server: Delete from Query History",
        "when": "contextValue == 'mssql.historyEntry'"
      },
      {
        "id": "mssql.clearQueryHistory",
        "title": "SQL Server: Clear Query History",
        "when": "contextValue == 'mssql.historyRoot' || contextValue == 'mssql.historyGroup'",
        "confirm": "Clear the whole query history of this connection?"
      },
      {
        "id": "mssql.history",
        "title": "SQL Server: List Query History",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.deleteHistory",
        "title": "SQL Server: Delete Query History",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.executeQuery",
        "title": "SQL Server: Execute Query",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.cancelQuery",
        "title": "SQL Server: Cancel Query",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.listDatabases",
        "title": "SQL Server: List Databases",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.serverInfo",
        "title": "SQL Server: Server Info",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.completionCatalog",
        "title": "SQL Server: IntelliSense Catalog",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.search",
        "title": "SQL Server: Search Objects",
        "hidden": true
      },
      {
        "id": "mssql.newFastQuery",
        "title": "SQL Server: New Fast Query…",
        "when": "contextValue == 'mssql.fastQueriesRoot' || contextValue == 'mssql.fastQueryGroup'"
      },
      {
        "id": "mssql.runFastQuery",
        "title": "SQL Server: Run Fast Query",
        "icon": "$(play)",
        "when": "contextValue == 'mssql.fastQuery'"
      },
      {
        "id": "mssql.runFastQueryOn",
        "title": "SQL Server: Run Fast Query on Database…",
        "when": "contextValue == 'mssql.fastQuery'",
        "inputSchema": {
          "type": "object",
          "required": [
            "targetDatabase"
          ],
          "properties": {
            "targetDatabase": {
              "type": "string",
              "title": "Database"
            }
          }
        }
      },
      {
        "id": "mssql.renameFastQuery",
        "title": "SQL Server: Rename Fast Query…",
        "when": "contextValue == 'mssql.fastQuery'",
        "inputSchema": {
          "type": "object",
          "required": [
            "newName"
          ],
          "properties": {
            "newName": {
              "type": "string",
              "title": "New name",
              "default": "{label}"
            }
          }
        }
      },
      {
        "id": "mssql.deleteFastQuery",
        "title": "SQL Server: Delete Fast Query",
        "when": "contextValue == 'mssql.fastQuery'",
        "confirm": "Delete fast query \"{label}\" (its .query.sql file)?"
      },
      {
        "id": "mssql.saveFastQuery",
        "title": "SQL Server: Save Fast Query",
        "hidden": true
      },
      {
        "id": "mssql.faker",
        "title": "SQL Server: Faker API",
        "hidden": true
      },
      {
        "id": "mssql.generateData",
        "title": "SQL Server: Generate Fake Data…",
        "when": "contextValue == 'mssql.table'"
      },
      {
        "id": "mssql.newFaker",
        "title": "SQL Server: New Faker…",
        "when": "contextValue == 'mssql.fakersRoot' || contextValue == 'mssql.fakerGroup'"
      },
      {
        "id": "mssql.attachFastToolsFolder",
        "title": "SQL Server: Attach Fast Tools Folder…",
        "when": "contextValue == 'mssql.fastToolsRoot' || contextValue == 'mssql.fastToolsFolder'",
        "inputSchema": {
          "type": "object",
          "required": [
            "folder"
          ],
          "properties": {
            "folder": {
              "type": "string",
              "title": "Folder for fast queries (*.query.sql) and fakers (*.faker.json)",
              "format": "directory"
            }
          }
        }
      },
      {
        "id": "mssql.detachFastToolsFolder",
        "title": "SQL Server: Detach Fast Tools Folder",
        "when": "contextValue == 'mssql.fastToolsFolder'",
        "confirm": "Detach this folder? Its fast queries and fakers stay on disk."
      },
      {
        "id": "mssql.runFaker",
        "title": "SQL Server: Run Faker (insert rows)",
        "when": "contextValue == 'mssql.faker'",
        "confirm": "Run faker \"{label}\" and insert its rows into the database?"
      },
      {
        "id": "mssql.renameFaker",
        "title": "SQL Server: Rename Faker…",
        "when": "contextValue == 'mssql.faker'",
        "inputSchema": {
          "type": "object",
          "required": [
            "newName"
          ],
          "properties": {
            "newName": {
              "type": "string",
              "title": "New name",
              "default": "{label}"
            }
          }
        }
      },
      {
        "id": "mssql.deleteFaker",
        "title": "SQL Server: Delete Faker",
        "when": "contextValue == 'mssql.faker' || contextValue == 'mssql.fakerBroken'",
        "confirm": "Delete faker \"{label}\" (its .faker.json file)? Data it already inserted stays."
      },
      {
        "id": "mssql.ai.schema",
        "title": "AI: List Tables and Columns",
        "hidden": true
      },
      {
        "id": "mssql.ai.query",
        "title": "AI: Run Read-Only Query",
        "hidden": true
      },
      {
        "id": "mssql.ai.execute",
        "title": "AI: Run Statement",
        "hidden": true
      }
    ],
    "searchProviders": [
      {
        "id": "objects",
        "label": "SQL objects",
        "command": "mssql.search",
        "order": 20,
        "icon": "$(database)"
      }
    ],
    "explorerSections": [
      {
        "id": "fastTools",
        "title": "Fast Tools",
        "rootNodeType": "mssql.fastToolsRoot",
        "connectionType": "mssql"
      },
      {
        "id": "queryHistory",
        "title": "Query History",
        "rootNodeType": "mssql.historyRoot",
        "connectionType": "mssql",
        "collapsed": true
      },
      {
        "id": "backgroundTasks",
        "title": "Background Tasks",
        "rootNodeType": "mssql.backgroundRoot",
        "connectionType": "mssql"
      }
    ],
    "menus": [
      {
        "menu": "run",
        "title": "Execute Query",
        "keybinding": "F5",
        "when": "activeView == 'mssql.query'",
        "group": "1_run"
      },
      {
        "menu": "run",
        "title": "Cancel Query",
        "keybinding": "Escape",
        "when": "activeView == 'mssql.query'",
        "group": "1_run"
      },
      {
        "menu": "run",
        "title": "Show Results",
        "keybinding": "Ctrl+R",
        "when": "activeView == 'mssql.query'",
        "group": "2_results"
      }
    ]
  },
  "activationEvents": [
    "onConnectionType:mssql"
  ]
}
