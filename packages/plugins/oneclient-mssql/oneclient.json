{
  "name": "oneclient-mssql",
  "displayName": "SQL Server",
  "description": "Connect to Microsoft SQL Server: object explorer, query editor, result grids and a fake-data generator — a small SSMS.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "icon.svg",
  "engines": {
    "oneclient": "^0.1.0"
  },
  "main": "dist/main.js",
  "ui": "dist/ui",
  "contributes": {
    "icons": [{ "id": "sql-server", "description": "Microsoft SQL Server", "path": "icon.svg", "colored": true }],
    "extensions": {
      "docker.containerTemplates": [
        {
          "id": "mssql",
          "title": "SQL Server 2022",
          "product": "SQL Server",
          "description": "SQL Server 2022 Developer edition (x64 hosts). The SA password must be at least 8 characters with 3 of: upper, lower, digit, symbol.",
          "icon": "$(sql-server)",
          "image": "mcr.microsoft.com/mssql/server:2022-latest",
          "imagePatterns": [
            "mcr\\.microsoft\\.com/mssql/server",
            "mcr\\.microsoft\\.com/azure-sql-edge"
          ],
          "ports": [
            {
              "container": "1433/tcp",
              "host": 1433,
              "label": "SQL Server"
            }
          ],
          "env": {
            "ACCEPT_EULA": "Y",
            "MSSQL_PID": "Developer",
            "MSSQL_SA_PASSWORD": "${password}"
          },
          "variables": {
            "password": {
              "label": "SA password",
              "secret": true,
              "from": [
                {
                  "env": "MSSQL_SA_PASSWORD"
                },
                {
                  "env": "SA_PASSWORD"
                }
              ]
            }
          },
          "connection": {
            "typeId": "mssql",
            "name": "Local SQL Server",
            "config": {
              "server": "${host},${port}",
              "authentication": "SQL Server Authentication",
              "user": "sa",
              "password": "${password}",
              "encrypt": true,
              "trustServerCertificate": true
            }
          },
          "startupSeconds": 150
        }
      ]
    },
    "connectionTypes": [
      {
        "id": "mssql",
        "label": "SQL Server",
        "description": "Microsoft SQL Server / Azure SQL",
        "category": "Databases",
        "icon": "icon.svg",
        "connectionLabel": "Server"
      }
    ],
    "explorerNodes": [
      {
        "id": "mssql.databases",
        "connectionType": "mssql"
      },
      {
        "id": "mssql.systemDatabases",
        "parentNodeType": "mssql.databases"
      },
      {
        "id": "mssql.database",
        "parentNodeType": "mssql.databases"
      },
      {
        "id": "mssql.tables",
        "parentNodeType": "mssql.database"
      },
      {
        "id": "mssql.table",
        "parentNodeType": "mssql.tables"
      },
      {
        "id": "mssql.views",
        "parentNodeType": "mssql.database"
      },
      {
        "id": "mssql.view",
        "parentNodeType": "mssql.views"
      },
      {
        "id": "mssql.columns",
        "parentNodeType": "mssql.table"
      },
      {
        "id": "mssql.column",
        "parentNodeType": "mssql.columns"
      },
      {
        "id": "mssql.indexes",
        "parentNodeType": "mssql.table"
      },
      {
        "id": "mssql.index",
        "parentNodeType": "mssql.indexes"
      },
      {
        "id": "mssql.programmability",
        "parentNodeType": "mssql.database"
      },
      {
        "id": "mssql.procedures",
        "parentNodeType": "mssql.programmability"
      },
      {
        "id": "mssql.procedure",
        "parentNodeType": "mssql.procedures"
      },
      {
        "id": "mssql.functions",
        "parentNodeType": "mssql.programmability"
      },
      {
        "id": "mssql.function",
        "parentNodeType": "mssql.functions"
      },
      {
        "id": "mssql.fakersRoot"
      },
      {
        "id": "mssql.fakerGroup",
        "parentNodeType": "mssql.fakersRoot"
      },
      {
        "id": "mssql.faker",
        "parentNodeType": "mssql.fakerGroup"
      }
    ],
    "views": [
      {
        "id": "mssql.query",
        "title": "Query",
        "tier": 2,
        "location": "editor",
        "entry": "index.html"
      },
      {
        "id": "mssql.results",
        "title": "Query Results",
        "tier": 2,
        "location": "panel",
        "entry": "results.html",
        "icon": "$(results)"
      },
      {
        "id": "mssql.faker",
        "title": "Fake Data",
        "tier": 2,
        "location": "editor",
        "entry": "faker.html",
        "icon": "$(wrench)"
      }
    ],
    "commands": [
      {
        "id": "mssql.newQuery",
        "title": "SQL Server: New Query",
        "when": "contextValue == 'connection' && connectionType == 'mssql' || contextValue == 'mssql.database'"
      },
      {
        "id": "mssql.selectTop",
        "title": "SQL Server: Select Top 1000 Rows",
        "when": "contextValue == 'mssql.table' || contextValue == 'mssql.view'"
      },
      {
        "id": "mssql.scriptCreate",
        "title": "SQL Server: Script Table as CREATE",
        "when": "contextValue == 'mssql.table'"
      },
      {
        "id": "mssql.scriptModify",
        "title": "SQL Server: Modify",
        "when": "contextValue == 'mssql.view' || contextValue == 'mssql.procedure' || contextValue == 'mssql.function'"
      },
      {
        "id": "mssql.scriptExecute",
        "title": "SQL Server: Script as EXECUTE",
        "when": "contextValue == 'mssql.procedure'"
      },
      {
        "id": "mssql.executeQuery",
        "title": "SQL Server: Execute Query",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.cancelQuery",
        "title": "SQL Server: Cancel Query",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.listDatabases",
        "title": "SQL Server: List Databases",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.serverInfo",
        "title": "SQL Server: Server Info",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.completionCatalog",
        "title": "SQL Server: IntelliSense Catalog",
        "when": "view == 'mssql.query'"
      },
      {
        "id": "mssql.search",
        "title": "SQL Server: Search Objects",
        "hidden": true
      },
      {
        "id": "mssql.faker",
        "title": "SQL Server: Faker API",
        "hidden": true
      },
      {
        "id": "mssql.generateData",
        "title": "SQL Server: Generate Fake Data…",
        "when": "contextValue == 'mssql.table'"
      },
      {
        "id": "mssql.newFaker",
        "title": "SQL Server: New Faker…",
        "when": "contextValue == 'mssql.fakersRoot' || contextValue == 'mssql.fakerGroup' || contextValue == 'mssql.fakersFolder'"
      },
      {
        "id": "mssql.attachFakersFolder",
        "title": "SQL Server: Attach Fakers Folder…",
        "when": "contextValue == 'mssql.fakersRoot' || contextValue == 'mssql.fakersFolder'",
        "inputSchema": {
          "type": "object",
          "required": [
            "folder"
          ],
          "properties": {
            "folder": {
              "type": "string",
              "title": "Folder with *.faker.json files",
              "format": "directory"
            }
          }
        }
      },
      {
        "id": "mssql.detachFakersFolder",
        "title": "SQL Server: Detach Fakers Folder",
        "when": "contextValue == 'mssql.fakersFolder'",
        "confirm": "Detach this folder? The faker files stay on disk."
      },
      {
        "id": "mssql.runFaker",
        "title": "SQL Server: Run Faker (insert rows)",
        "when": "contextValue == 'mssql.faker'",
        "confirm": "Run faker \"{label}\" and insert its rows into the database?"
      },
      {
        "id": "mssql.renameFaker",
        "title": "SQL Server: Rename Faker…",
        "when": "contextValue == 'mssql.faker'",
        "inputSchema": {
          "type": "object",
          "required": [
            "newName"
          ],
          "properties": {
            "newName": {
              "type": "string",
              "title": "New name",
              "default": "{label}"
            }
          }
        }
      },
      {
        "id": "mssql.deleteFaker",
        "title": "SQL Server: Delete Faker",
        "when": "contextValue == 'mssql.faker' || contextValue == 'mssql.fakerBroken'",
        "confirm": "Delete faker \"{label}\" (its .faker.json file)? Data it already inserted stays."
      }
    ],
    "searchProviders": [
      {
        "id": "objects",
        "label": "SQL objects",
        "command": "mssql.search",
        "order": 20,
        "icon": "$(database)"
      }
    ],
    "explorerSections": [
      {
        "id": "fakers",
        "title": "Fakers",
        "rootNodeType": "mssql.fakersRoot",
        "connectionType": "mssql"
      }
    ],
    "menus": [
      {
        "menu": "run",
        "title": "Execute Query",
        "keybinding": "F5",
        "when": "activeView == 'mssql.query'",
        "group": "1_run"
      },
      {
        "menu": "run",
        "title": "Cancel Query",
        "keybinding": "Escape",
        "when": "activeView == 'mssql.query'",
        "group": "1_run"
      },
      {
        "menu": "run",
        "title": "Show Results",
        "keybinding": "Ctrl+R",
        "when": "activeView == 'mssql.query'",
        "group": "2_results"
      }
    ]
  },
  "activationEvents": [
    "onConnectionType:mssql"
  ]
}
