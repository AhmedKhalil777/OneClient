{
  "name": "oneclient-mssql",
  "version": "0.1.0",
  "description": "oneClient plugin: connect to Microsoft SQL Server — object explorer and query editor.",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:node": "tsc -b",
    "build:ui": "vite build",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "dependencies": {
    "@oneclient/editor-kit": "workspace:*",
    "@oneclient/plugin-api": "workspace:*",
    "mssql": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  }
}
