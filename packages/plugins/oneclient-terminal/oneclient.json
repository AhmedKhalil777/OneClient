{
  "name": "oneclient-terminal",
  "displayName": "Terminal",
  "description": "Built-in: integrated terminal in the bottom panel — PowerShell, Command Prompt, Git Bash, WSL, bash/zsh.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "icon.svg",
  "engines": { "oneclient": "^0.1.0" },
  "main": "dist/main.js",
  "ui": "dist/ui",
  "contributes": {
    "views": [{ "id": "terminal.panel", "title": "Terminal", "tier": 2, "location": "panel", "entry": "index.html", "icon": "$(terminal)" }],
    "commands": [
      {
        "id": "terminal.openAt",
        "title": "Terminal: Open in Terminal",
        "when": "contextValue == 'files.directory' || contextValue == 'files.file'"
      }
    ]
  },
  "activationEvents": ["*"]
}
