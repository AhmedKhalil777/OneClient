{
  "name": "oneclient-terminal",
  "version": "0.1.0",
  "description": "oneClient built-in plugin: integrated terminal (PowerShell, cmd, bash, …) in the bottom panel.",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:node": "tsc -b",
    "build:ui": "vite build",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "dependencies": {
    "@oneclient/editor-kit": "workspace:*",
    "@oneclient/plugin-api": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  }
}
