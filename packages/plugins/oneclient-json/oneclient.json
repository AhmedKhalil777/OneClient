{
  "name": "oneclient-json",
  "displayName": "JSON Tools",
  "description": "Built-in: JSON support for the Files editor — format, minify, breadcrumbs showing the path at the cursor, and syntax highlighting.",
  "version": "0.1.0",
  "publisher": "oneclient",
  "license": "MIT",
  "icon": "$(symbol)",
  "engines": { "oneclient": "^0.1.0" },
  "main": "dist/main.js",
  "contributes": {
    "commands": [
      { "id": "json.format", "title": "JSON: Format Document", "hidden": true },
      { "id": "json.minify", "title": "JSON: Minify", "hidden": true },
      { "id": "json.symbols", "title": "JSON: Document Symbols", "hidden": true },
      { "id": "json.tokens", "title": "JSON: Syntax Tokens", "hidden": true }
    ],
    "extensions": {
      "oneclient-files.editors": [
        {
          "id": "json",
          "label": "JSON",
          "extensions": ["json", "jsonc", "geojson", "topojson", "webmanifest", "har", "code-workspace"],
          "fileNames": [".babelrc", ".eslintrc", ".prettierrc", ".stylelintrc", ".swcrc"],
          "format": "json.format",
          "symbols": "json.symbols",
          "tokens": "json.tokens",
          "actions": [{ "id": "minify", "label": "Minify JSON", "command": "json.minify" }]
        }
      ]
    }
  }
}
