{
  "name": "@oneclient/sql-core",
  "version": "0.1.0",
  "description": "The shared base of oneClient's SQL plugins: query windows, results, history and Fast Tools (fast queries, and tools a dialect turns on, like fakers).",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./ui/index.ts",
    "./ui/styles.css": "./ui/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oneclient/plugin-api": "workspace:*"
  },
  "peerDependencies": {
    "@oneclient/editor-kit": "workspace:*",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@oneclient/editor-kit": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oneclient/editor-kit": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  }
}
