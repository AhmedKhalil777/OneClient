{
  "name": "oneclient-sample",
  "displayName": "Sample (dev fixture)",
  "description": "In-memory fixture plugin for exercising the plugin loader and extension host.",
  "version": "0.1.0",
  "icon": "icon.svg",
  "engines": { "oneclient": "^0.1.0" },
  "main": "main.mjs",
  "ui": "ui",
  "contributes": {
    "connectionTypes": [{ "id": "sample", "label": "Sample (in-memory)", "category": "Dev", "icon": "icon.svg" }],
    "explorerNodes": [{ "id": "sample.item", "connectionType": "sample" }],
    "commands": [{ "id": "sample.sayHello", "title": "Sample: Say Hello" }],
    "views": [
      {
        "id": "sample.dashboard",
        "title": "Sample Dashboard",
        "tier": 2,
        "location": "editor",
        "entry": "index.html",
        "connectionType": "sample"
      }
    ]
  },
  "activationEvents": ["*"]
}
