{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@oneclient/backend/*": ["../backend/src/*"]
    }
  },
  "include": ["src/main", "src/preload"]
}
