{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
