{
  "name": "@oneclient/core",
  "private": true,
  "version": "0.1.0",
  "description": "oneClient desktop app: the Electron shell around @oneclient/backend (main process, preloads, native windows and views) with the @oneclient/workbench UI. The web runtime is @oneclient/server.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @oneclient/backend run build && electron-vite dev",
    "build": "pnpm --filter @oneclient/backend run build && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "icons": "electron scripts/render-icons.cjs"
  },
  "dependencies": {
    "@oneclient/backend": "workspace:*",
    "@oneclient/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@oneclient/workbench": "workspace:*",
    "electron": "^42.11.16",
    "electron-builder": "26.18.0",
    "electron-vite": "^3.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5",
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
