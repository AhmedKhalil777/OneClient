{
  "name": "@oneclient/core",
  "private": true,
  "version": "0.1.0",
  "description": "oneClient desktop app: the Electron shell around @oneclient/backend (main process, preloads, native windows and views) with the @oneclient/workbench UI. The web runtime is @oneclient/server.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "icons": "electron scripts/render-icons.cjs"
  },
  "dependencies": {
    "@oneclient/backend": "workspace:*",
    "@oneclient/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@oneclient/workbench": "workspace:*",
    "electron": "^33.2.0",
    "electron-builder": "25.1.8",
    "electron-vite": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11",
    "typescript": "^5.6.0",
    "@types/node": "^20.14.0"
  }
}
